{
    "name": "Spring Boot & MongoDB Dev Container",
    "dockerComposeFile": "../compose.yml",
    "service": "app",
    "workspaceFolder": "/workspace/spring-mongo-docker",

    // Configure tool-specific properties.
    "customizations": {
        // Configure properties specific to VS Code.
        "vscode": {
            "settings": {
                "java.jdt.ls.java.home": "/usr/lib/jvm/temurin-17-jdk"
            },
            "extensions": [
                "vscjava.vscode-java-pack",
                "vmware.vscode-spring-boot",
                "Pivotal.vscode-spring-boot",
                "vscjava.vscode-maven",
                "ms-azuretools.vscode-docker",
                "humao.rest-client"
            ]
        }
    },

    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    "forwardPorts": [8080, 5005],

    // Use 'postCreateCommand' to run commands after the container is created.
    "postCreateCommand": "sudo mvn clean install -DskipTests",

    // Connect as the non-root user.
    "remoteUser": "vscode"
}

